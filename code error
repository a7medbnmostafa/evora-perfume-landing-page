function handleQuizSelection(step, valueText) {
  if (step === 1) {
    quizAnswers.gender = GENDER_MAP[valueText] || valueText;
  }

  if (step === 2) {
    quizAnswers.family = FAMILY_MAP[valueText] || [valueText];
  }

  if (step === 3) {
    quizAnswers.feeling = FEELING_MAP[valueText] || [valueText];
  }
}

function selectOptionUI(step, element) {
  selectedElements[step] = element;

  const optionText = element.querySelector("span")
    ? element.querySelector("span").textContent.trim()
    : element.textContent.trim();

  handleQuizSelection(step, optionText);

  const buttons = document.querySelectorAll(`.opt-btn-${step}`);

  buttons.forEach((btn) => {
    btn.classList.remove(
      "border-brand-gold",
      "bg-brand-gold/10",
      "text-brand-gold",
    );

    btn.classList.add(
      "border-brand-gold/20",
      "bg-brand-emerald/40",
      "text-brand-cream",
    );

    const checkIcon = btn.querySelector(".check-icon");

    if (checkIcon) {
      checkIcon.classList.add("hidden");
    }
  });

  element.classList.remove(
    "border-brand-gold/20",
    "bg-brand-emerald/40",
    "text-brand-cream",
  );

  element.classList.add(
    "border-brand-gold",
    "bg-brand-gold/10",
    "text-brand-gold",
  );

  const selectedCheck = element.querySelector(".check-icon");

  if (selectedCheck) {
    selectedCheck.classList.remove("hidden");
  }

  enableNextButton(true);
}

