  const titleEl = document.querySelector("#quiz-result-step h3");

  const descEl = document.querySelector("#quiz-result-step p");

  const whatsappBtn = document.querySelector("#quiz-result-step a");

  if (titleEl) {
    titleEl.textContent =
      perfume.name + (perfume.latin ? ` (${perfume.latin})` : "");
  }

  if (descEl) {
    descEl.textContent = perfume.desc;
  }

  if (whatsappBtn) {
    const message = `مرحباً، قمت باختبار العطور على الموقع الخاص بكم وتم ترشيح عطر Évora (${perfume.name}) لي. أرغب في الاستفسار عن تفاصيله وطلبه.`;

    const encodedMsg = encodeURIComponent(message);

    whatsappBtn.href = `https://wa.me/${WHATSAPP_PHONE}?text=${encodedMsg}`;

    whatsappBtn.target = "_blank";
  }
}

