/* =========================================================
         SCORING
      ========================================================== */

const WEIGHTS = {
  GENDER_MATCH: 3,
  FAMILY_MATCH: 3,
  FEELING_MATCH: 2,
  TIER_PREMIUM_BONUS: 0.5,
};

function calculateScore(answers, list) {
  if (!list || list.length === 0) {
    return null;
  }

  let bestMatch = null;
  let highestScore = -1;

  list.forEach((perfume) => {
    let currentScore = 0;

    /* Gender */
    if (
      perfume.gender === answers.gender ||
      perfume.gender === "يونيسكس" ||
      answers.gender === "يونيسكس"
    ) {
      currentScore += WEIGHTS.GENDER_MATCH;
    }

    /* Family */
    if (Array.isArray(perfume.families) && Array.isArray(answers.family)) {
      const hasFamilyMatch = answers.family.some((f) =>
        perfume.families.includes(f),
      );

      if (hasFamilyMatch) {
        currentScore += WEIGHTS.FAMILY_MATCH;
      }
    }

    /* Feeling */
    if (Array.isArray(perfume.families) && Array.isArray(answers.feeling)) {
      const hasFeelingMatch = answers.feeling.some((f) =>
        perfume.families.includes(f),
      );

      if (hasFeelingMatch) {
        currentScore += WEIGHTS.FEELING_MATCH;
      }
    }

    /* Premium bonus */
    if (perfume.tier === "premium") {
      currentScore += WEIGHTS.TIER_PREMIUM_BONUS;
    }

    if (currentScore > highestScore) {
      highestScore = currentScore;

      bestMatch = {
        ...perfume,
        score: currentScore,
      };
    }
  });

  return bestMatch;
}

