      if (menuIcon) {
        menuIcon.classList.remove('fa-xmark');
        menuIcon.classList.add('fa-bars');
      }
    }
  }

  // === 2. تحديث عداد السلة من LocalStorage ===
  window.updateCartBadge = function () {
    const cartBadges = document.querySelectorAll('.cart-badge');
    try {
      const cart = JSON.parse(localStorage.getItem('cart')) || [];
      // حساب إجمالي عدد المنتجات مع مراعاة الكمية (quantity)
      const totalItems = cart.reduce((sum, item) => sum + (item.quantity || 1), 0);

      cartBadges.forEach((badge) => {
        badge.textContent = totalItems;
      });
    } catch (e) {
      cartBadges.forEach((badge) => {
        badge.textContent = 0;
      });
    }
  };

  // الاستماع لأي تغيير في LocalStorage من صفحات أخرى
  window.addEventListener('storage', (e) => {
    if (e.key === 'cart') {
      window.updateCartBadge();
    }
  });

  // الاستماع لـ Custom Event لتحديث السلة مباشرة من داخل نفس الصفحة عند إضافة منتج
  window.addEventListener('cartUpdated', () => {
    window.updateCartBadge();
  });

  // تشغيل التحديث فور تحمِيل الصفحة
  window.updateCartBadge();

  // === 3. تغيير خلفية الـ Header عند الـ Scroll ===
  const header = document.getElementById('main-header');
  window.addEventListener('scroll', () => {
    if (!header) return;
    if (window.scrollY > 40) {
      header.classList.add('shadow-lg', 'bg-brand-emeraldDark');
      header.classList.remove('bg-brand-emeraldDark/90');
    } else {
      header.classList.add('bg-brand-emeraldDark/90');
      header.classList.remove('shadow-lg');
    }
  });
});




































